# Copy this file to .env  (cp env.example .env)

# --- Gemini (optional) ---------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# Without a key the proxy runs the deterministic simulated agent ("Modo simulado").
GEMINI_API_KEY=
# Default: gemini-3.8-flash
GEMINI_MODEL=
# Optional thinking level: MINIMAL | LOW | MEDIUM | HIGH | XHIGH. Empty = model default.
GEMINI_THINKING_LEVEL=

# --- Agent mode ------------------------------------------------------------
# gemini | mock   (mock = scripted agent, no network needed)
AGENT_MODE=

# --- Proxy -----------------------------------------------------------------
PORT=8787
# Comma-separated browser origins allowed by CORS.
# Default: http://localhost:5173,http://127.0.0.1:5173 (where attendees run the app).
# CORS only binds browsers; it does not stop curl or scripts.
ALLOWED_ORIGINS=

# --- Hosting the proxy for the room (instructor only) -----------------------
# Shared room token. Empty = open proxy (local development / mock mode).
# Minimum 24 characters (the server refuses to start otherwise): openssl rand -hex 16
# When set, /api/chat requires it as a path prefix (/t/<token>/api/chat),
# "Authorization: Bearer <token>" or "x-workshop-token: <token>".
WORKSHOP_TOKEN=
# DISTINCT failed tokens per client IP per minute before answering 429 (not attempts:
# repeating the same wrong or missing token counts once, so a room behind one IP with a
# shared typo is not locked out; a brute-forcer trying new values is). Default: 30
AUTH_FAILURES_PER_MINUTE=
# EXACT number of trusted reverse proxies in front of the server (load balancer, PaaS).
# Empty/0 = ignore x-forwarded-for and use the socket address (spoof-proof).
TRUST_PROXY=
# Requests per minute per client IP. A boss prompt is up to 9 calls and the whole room
# may share one NAT IP. Default: 600 with WORKSHOP_TOKEN, 60 without.
RATE_LIMIT_PER_MINUTE=
# Requests per minute for the whole proxy. Default: 1500 with WORKSHOP_TOKEN, 600 without.
RATE_LIMIT_GLOBAL_PER_MINUTE=
# Request size caps. Defaults: 262144 bytes, 60 messages, 8000 chars per user message,
# 32000 chars per model text part, 32 tools, 8192 bytes per tool schema.
MAX_BODY_BYTES=
MAX_MESSAGES=
MAX_TEXT_CHARS=
MAX_MODEL_TEXT_CHARS=
MAX_TOOLS=
MAX_TOOL_SCHEMA_BYTES=
# Max tokens Gemini may generate per call. Thinking tokens count too: too low a value
# yields empty replies. Default: 8192
MAX_OUTPUT_TOKENS=

# --- Using the instructor's hosted proxy (no key needed) -------------------
# Paste the URL the instructor gives you, including the token path:
#   https://proxy.example/t/<token>
# Option A (recommended): Vite forwards /api to this URL during `npm run dev`.
AGENT_BASE_URL=
# Option B: the browser calls this URL directly (needs CORS on the proxy).
VITE_AGENT_URL=

# --- Slides (instructor only) ------------------------------------------------
# Full room proxy URL, token included, projected on the "proxy" slide (Act 2).
# Lives only in your local .env (gitignored): the repo keeps the <token> placeholder.
VITE_ROOM_PROXY_URL=
