{
  "name": "workshop-web-mcp",
  "private": true,
  "version": "1.0.0",
  "description": "DevFest Bogotá 2026 workshop: give a web store eyes and hands with WebMCP.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,proxy -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "server:mock": "tsx server/index.ts --mock",
    "build": "vite build",
    "preview": "vite preview",
    "slides": "vite --open /slides/",
    "guide": "vite --open /guide/",
    "build:guide": "vite build --config vite.guide.config.ts",
    "preview:guide": "vite preview --config vite.guide.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check": "node scripts/check-env.mjs",
    "eval:injection": "tsx scripts/injection-eval.ts"
  },
  "dependencies": {
    "@google/genai": "^3.4.0",
    "@hono/node-server": "^2.1.9",
    "dotenv": "^18.0.10",
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/google-sans": "^5.3.2",
    "@fontsource-variable/google-sans-code": "^5.3.2",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@khriztianmoreno/speaker-kit": "^1.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.1",
    "marked": "^18.2.1",
    "mermaid": "12.3.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
